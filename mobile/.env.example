# Copy to ".env" and restart Metro with `npx expo start --clear`.

# Base URL of the LacoQR API. Leave empty to use http://localhost:3000/api on
# web/iOS or http://10.0.2.2:3000/api on the Android emulator. Phones on Expo Go
# need a tunnel or LAN URL — the sign-in screen's "Server" field overrides this
# per device.
EXPO_PUBLIC_API_URL=

# Supabase project settings. The publishable (anon) key is safe to ship in the
# app; never use the service-role key here. Google sign-in is hidden when these
# are empty.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
