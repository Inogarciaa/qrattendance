# Supabase project (safe to ship in the app; the anon key is public)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public base URL of the Scanly API, including /api.
# Local development: http://localhost:3000/api (Android emulator: http://10.0.2.2:3000/api)
# Production: the Render URL, e.g. https://lacoqr-api.onrender.com/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api
