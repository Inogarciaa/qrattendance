{
  "expo": {
    "name": "LacoQR",
    "slug": "lacoqr",
    "scheme": "lacoqr",
    "owner": "tsmvipe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lacoqr.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "LacoQR uses your camera to scan event attendance QR codes."
      }
    },
    "android": {
      "package": "com.lacoqr.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0f1c3f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "LacoQR uses your camera to scan event attendance QR codes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "LacoQR uses your photo library so you can add a profile picture.",
          "cameraPermission": "LacoQR uses your camera so you can take a profile picture."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LacoQR checks that your phone is at the event venue when you check in."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2a77b495-4912-474a-8fa6-2ef70201e564"
      }
    }
  }
}
