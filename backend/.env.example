PORT=3000
SUPABASE_URL=https://your-project.supabase.co
# Supabase dashboard -> Project Settings -> API keys
# Older projects call these "anon" and "service_role".
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# "supabase" or "local". Leave empty to auto-detect from the credentials above.
DATA_MODE=

# Password = digits(school_id) + YYYYMMDD(birthdate). Domain for synthetic auth emails.
AUTH_EMAIL_DOMAIN=lccb.local

# Web dashboard staff accounts (used by seed.js and local development mode).
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=change-me-superadmin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
